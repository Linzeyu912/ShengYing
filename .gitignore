# 音频素材本体（体积大，不入 git；元数据与目录结构保留）
assets/voices/*/samples/*.wav
assets/archive/**/*.wav
assets/sfx/**/*.wav
assets/ambience/**/*.wav

# 模型权重（如后续内置 VoxCPM）
models/

# 第三方源码（各自持有上游 git 仓库，本地研究用）
third_party/

# 离线安装包（大体积 whl，本地留存方便团队复用）
packages/

# 测试与生成输出
outputs/

# 生成记录：音频不入 git，元数据 record.json 保留追溯
generations/*/audio.wav

# 场次混音产物：音频不入 git，混音配置（scene.json）保留
scenes/*/mix.wav
scenes/*/dialogue.wav

# Python
__pycache__/
*.pyc
.venv/

# 系统文件
Thumbs.db
.DS_Store
